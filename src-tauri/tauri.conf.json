{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NintCode",
  "version": "0.5.0",
  "identifier": "ai.nintcode.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NintCode — Free Local AI Coding Workspace",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Free local AI coding workspace",
    "longDescription": "NintCode — free, local-first AI IDE with GPU acceleration, agent mode and Model Hub."
  }
}
